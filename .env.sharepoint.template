# =====================================================
# SharePoint & Azure Entra ID Configuration Template
# =====================================================
# IMPORTANTE: Este archivo es un TEMPLATE
# Para desarrollo: Copiar a .env.sharepoint y completar
# Para producción: Usar valores reales de Azure Portal
#
# DO NOT COMMIT credenciales reales a Git
# =====================================================

# =====================================================
# Azure Entra ID (antigua Azure AD)
# Obtener de: portal.azure.com → App Registrations
# =====================================================

# Tu Tenant ID (ej: xxxxxx.onmicrosoft.com)
AZURE_TENANT_ID=xxxxxx.onmicrosoft.com

# Client ID (Application ID) de tu app registration
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client Secret (generar en Certificates & secrets)
# ⚠️ NUNCA commitear esto a Git
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =====================================================
# SharePoint Site Configuration
# =====================================================

# Nombre de tu tenant (antes de .sharepoint.com)
# Ej: "contoso" para contoso.sharepoint.com
SHAREPOINT_TENANT=your-tenant

# Nombre del SharePoint Site donde guardar documentos
# Ej: "RFC-Management"
SHAREPOINT_SITE_NAME=RFC-Management

# Nombre de la carpeta dentro del site para guardar MDs
# Ej: "Markdown" o "Documentos Convertidos"
SHAREPOINT_FOLDER_NAME=Markdown

# =====================================================
# MCP Server SharePoint Configuration
# =====================================================

# Habilitar/Deshabilitar sincronización con SharePoint
SHAREPOINT_SYNC_ENABLED=true

# Sincronizar automáticamente después de conversión
# true = Sync inmediato después de convertir
# false = Sync bajo demanda
SHAREPOINT_AUTO_SYNC=false

# Timeout para operaciones SharePoint (en milisegundos)
SHAREPOINT_REQUEST_TIMEOUT=30000

# =====================================================
# DEVELOPMENT MODE: Mock SharePoint
# =====================================================

# Para desarrollo SIN acceso a Entra ID:
# Descomentar la línea siguiente para usar mock filesystem
SHAREPOINT_MOCK_MODE=true

# Ruta para mock de SharePoint (en desarrollo)
SHAREPOINT_MOCK_PATH=/app/sharepoint_mock

# =====================================================
# Logging & Debugging
# =====================================================

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info

# Guardar logs detallados de SharePoint operations
SHAREPOINT_DEBUG_LOG=false

# =====================================================
# FIN: Template de Configuración SharePoint
# =====================================================
