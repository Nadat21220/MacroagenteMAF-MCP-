# Database Configuration
DATABASE_URL=postgresql://rfcadmin:rfcsecurepass@localhost:5432/rfc_system_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=rfcadmin
DB_PASSWORD=rfcsecurepass
DB_NAME=rfc_system_db

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# SharePoint Configuration
SHAREPOINT_MODE=mock
SHAREPOINT_SITE_URL=https://your-org.sharepoint.com/sites/rfc-management
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Configuration
API_TIMEOUT=30
MAX_RETRIES=3

# Storage
STORAGE_PATH=/data/rfc_storage
